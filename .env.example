LINGJING_ENV=development
LINGJING_DATA_DIR=./data

# Optional web research. Point this to a JSON search endpoint that accepts q + format=json.
LINGJING_WEB_SEARCH_URL=
LINGJING_WEB_SEARCH_KEY=

# Optional local multimodal perception. The endpoint must be OpenAI-compatible.
LINGJING_VISION_BASE_URL=
LINGJING_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
LINGJING_VISION_API_KEY=

# Production access boundary
# LINGJING_ENV=production
# LINGJING_ACCESS_TOKEN=replace-with-a-long-random-secret
# LINGJING_SESSION_TTL_SECONDS=43200
# LINGJING_COOKIE_SECURE=1
# Public DNS names accepted in the Host header. When this variable is unset,
# localhost/test hosts and IP literals stay available for local/container traffic.
# Once LINGJING_ALLOWED_HOSTS is explicitly set, it becomes authoritative: list
# every accepted DNS name and IP literal explicitly. Wildcards are explicit, e.g. *.example.com.
# LINGJING_ALLOWED_HOSTS=app.example.com,10.20.30.40
# Browser mutations are same-origin by scheme + host + effective port by default.
# Only set this when a separate trusted browser origin must call the API directly.
# The repository runs Uvicorn with --no-proxy-headers, so a TLS-terminating reverse
# proxy does not implicitly rewrite the ASGI request scheme. In that topology,
# explicitly list the external HTTPS origin here rather than broadly trusting
# X-Forwarded-Proto.
# LINGJING_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
# Grace window for active runs to stop at a checkpoint and release their worker lease.
# LINGJING_SHUTDOWN_GRACE_SECONDS=25
# Trust X-Forwarded-For only when the immediate TCP peer is in one of these networks.
# Examples: a Docker bridge subnet, an internal load-balancer CIDR, or one proxy /32.
# LINGJING_TRUSTED_PROXY_CIDRS=172.18.0.0/16,10.20.30.40/32
# Legacy compatibility: this switch alone trusts loopback proxies only.
# LINGJING_TRUST_PROXY_IP=1
# The repository container starts Uvicorn with --no-proxy-headers so the app can
# validate the original TCP peer before considering X-Forwarded-For. If you run
# Uvicorn yourself, keep proxy-header preprocessing disabled; do not use
# FORWARDED_ALLOW_IPS=* or another broad Uvicorn trust setting in front of this resolver.
