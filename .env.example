LINGJING_ENV=development
LINGJING_DATA_DIR=./data

# Optional web research. Point this to a JSON search endpoint that accepts q + format=json.
LINGJING_WEB_SEARCH_URL=
LINGJING_WEB_SEARCH_KEY=

# Optional local multimodal perception. The endpoint must be OpenAI-compatible.
LINGJING_VISION_BASE_URL=
LINGJING_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
LINGJING_VISION_API_KEY=
