LINGJING_ENV=development
LINGJING_DATA_DIR=./data

# Optional web research. Point this to a JSON search endpoint that accepts q + format=json.
LINGJING_WEB_SEARCH_URL=
LINGJING_WEB_SEARCH_KEY=

# Optional local multimodal perception. The endpoint must be OpenAI-compatible.
LINGJING_VISION_BASE_URL=
LINGJING_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
LINGJING_VISION_API_KEY=

# Production access boundary
# LINGJING_ENV=production
# LINGJING_ACCESS_TOKEN=replace-with-a-long-random-secret
# LINGJING_SESSION_TTL_SECONDS=43200
# LINGJING_COOKIE_SECURE=1
# Grace window for active runs to stop at a checkpoint and release their worker lease.
# LINGJING_SHUTDOWN_GRACE_SECONDS=25
# Trust X-Forwarded-For only when the immediate TCP peer is in one of these networks.
# Examples: a Docker bridge subnet, an internal load-balancer CIDR, or one proxy /32.
# LINGJING_TRUSTED_PROXY_CIDRS=172.18.0.0/16,10.20.30.40/32
# Legacy compatibility: this switch alone trusts loopback proxies only.
# LINGJING_TRUST_PROXY_IP=1
